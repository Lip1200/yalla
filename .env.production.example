# Yalla production .env — copy to `.env` on the droplet, fill the values,
# then run `docker compose up -d --build`.
#
# Lines marked REQUIRED must be set. Others have sensible defaults.

# ====== Deployment host =======================================================

# Public hostname Caddy will serve from. Either:
#   • a real domain you control      : "yalla.example.com"
#   • a free *.nip.io DNS pointer    : "138-197-12-34.nip.io"  (replace with droplet IP, dashes for dots)
#   • plain HTTP on the bare IP      : ":80"                   (no TLS, useful only for a quick demo)
DEPLOY_HOST=YOUR-DROPLET-IP.nip.io

# Optional — Let's Encrypt uses this for renewal warning emails.
LETSENCRYPT_EMAIL=you@example.com

# ====== Supabase ==============================================================

# REQUIRED. From your Supabase project settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...your-publishable-key

# ====== App secrets ===========================================================

# REQUIRED. Strong random token used as the demo/CI service-token fallback
# in src/core/security.py. NEVER reuse the default "yalla-secret-token" in prod.
# Generate via: openssl rand -base64 48 | tr -d /+= | head -c 48
API_SECRET_TOKEN=replace-with-a-strong-random-token

# ====== CORS ==================================================================

# Comma-separated list of allowed origins. Must include the doctor-web origin
# AND the patient-app dev origin if you point Expo at this backend during demos.
CORS_ORIGINS=https://YOUR-DROPLET-IP.nip.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# ====== Invitation URLs (issue #33) ===========================================

# Used by the create-patient-account endpoint to build the invitation_url
# returned to the doctor. Patient-app's setup screen extracts ?token=... from it.
FRONTEND_BASE_URL=https://YOUR-DROPLET-IP.nip.io

# ====== Frontend build-time settings ==========================================

# Where the doctor-web SPA should send its API calls. Same value as DEPLOY_HOST
# because Caddy routes /api/* → backend. Baked into the bundle at build time.
VITE_API_BASE_URL=https://YOUR-DROPLET-IP.nip.io

# ====== Optional ===============================================================

# TheFork integration is mock-mode by default when empty (cf. config.py).
THEFORK_API_KEY=

# Overpass (OSM) endpoint — keep the default unless you self-host an instance.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Setup-token TTL (days). Default 7 is fine for most flows.
SETUP_TOKEN_TTL_DAYS=7
