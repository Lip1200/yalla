# ─── Self-hosted Supabase stack — secrets template ──────────────────
#
# Copy this file to `.env` (gitignored), fill in the placeholders, then
# pass it to docker compose via `--env-file deploy/self-hosted/.env`.
#
# Generation commands (macOS / Linux):
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
#   JWT_SECRET=$(openssl rand -hex 32)
#   DASHBOARD_PASSWORD=$(openssl rand -hex 16)
#
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET.
# Generate them with:
#   uv run python deploy/self-hosted/scripts/gen-jwt.py "$JWT_SECRET"

# ── Database ────────────────────────────────────────────────────────
# Shared by all Supabase services that hit Postgres.
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────
# At least 32 bytes of entropy. Changing this invalidates every
# existing session AND requires regenerating ANON_KEY + SERVICE_ROLE_KEY.
JWT_SECRET=

# ── API keys (regenerate together with JWT_SECRET) ──────────────────
# Long JWT — public, can be shipped to clients.
ANON_KEY=

# Long JWT — backend-only. Bypasses RLS. Treat like a root password.
SERVICE_ROLE_KEY=

# ── Public URLs ─────────────────────────────────────────────────────
# Used by GoTrue for redirect URIs (email links, OAuth callbacks).
# Match whatever Caddy serves the frontend on.
SITE_URL=https://46-101-16-132.nip.io

# ── Studio dashboard (optional) ─────────────────────────────────────
DASHBOARD_USERNAME=yalla
DASHBOARD_PASSWORD=
